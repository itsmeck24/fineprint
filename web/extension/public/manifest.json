{
  "manifest_version": 3,
  "name": "FinePrint",
  "version": "0.1.0",
  "description": "Shows the eligibility rules of a Greenhouse or Lever job posting, with the sentence each one comes from.",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://job-boards.greenhouse.io/*/jobs/*", "https://boards.greenhouse.io/*/jobs/*", "https://jobs.lever.co/*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
