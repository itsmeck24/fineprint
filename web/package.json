{
  "name": "fineprint-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:extension",
    "typecheck": "tsc -b",
    "e2e": "playwright test",
    "build:extension": "vite build -c vite.extension.config.ts --mode content && vite build -c vite.extension.config.ts --mode background && vite build -c vite.extension.config.ts --mode options",
    "build:site": "python3 ../eval/site_data.py && vite build -c vite.site.config.ts",
    "dev:site": "vite -c vite.site.config.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/chrome": "0.3.7",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
